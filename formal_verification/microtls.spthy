theory microtls
begin

/* Tamarin model: SPsec microtls. */

functions: hkdf/2, mac/2

/* PSK per (participant, key type). Zero Key is public by design. */
rule Setup_PSK:
  [ Fr(~psk) ]
  --[ Neq($ks, 'zero'), OnlyOnce(<$P, $ks>) ]->
  [ !PSK($P, $ks, ~psk) ]

rule Setup_ZeroKey:
  [ ]
  --[ OnlyOnce(<$P, 'zero'>) ]->
  [ !PSK($P, 'zero', 'zerokey') ]

rule Reveal_PSK:
  [ !PSK(P, ks, psk) ]
  --[ Reveal(P, ks) ]->
  [ Out(psk) ]

/* Client */
rule C1_ClientHello:
  [ Fr(~rndA), !PSK($P, $ks, psk) ]
  -->
  [ St_C1($P, $ks, psk, ~rndA), Out(<'hello', $P, $ks, ~rndA>) ]

rule C2_ClientFinished:
  let k    = hkdf(psk, <rndA, rndB>)
      tagC = mac(k, <'1', <'cf', P, ks, rndA, rndB>>)
  in
  [ St_C1(P, ks, psk, rndA), In(<'shello', P, rndB>) ]
  --[ C_Running(P, ks, rndA, rndB, k) ]->
  [ St_C2(P, ks, k, rndA, rndB, tagC), Out(<'cfin', P, tagC>) ]

rule C3_VerifyServerFinished:
  [ St_C2(P, ks, k, rndA, rndB, tagC),
    In(<'sfin', P, mac(k, <'2', <'sf', P, rndA, rndB, tagC>>)>) ]
  --[ C_Accept(P, ks, rndA, rndB, k), Secret(P, ks, k) ]->
  [ ]

/* Server (Participant). Seed Key is rejected for handshakes. */
rule S1_ServerHello:
  [ In(<'hello', $P, ks, rndA>), !PSK($P, ks, psk), Fr(~rndB) ]
  --[ Neq(ks, 'seed') ]->
  [ St_S1($P, ks, psk, rndA, ~rndB), Out(<'shello', $P, ~rndB>) ]

rule S2_VerifyClientFinished:
  let k    = hkdf(psk, <rndA, rndB>)
      tagC = mac(k, <'1', <'cf', P, ks, rndA, rndB>>)
      tagS = mac(k, <'2', <'sf', P, rndA, rndB, tagC>>)
  in
  [ St_S1(P, ks, psk, rndA, rndB), In(<'cfin', P, tagC>) ]
  --[ S_Accept(P, ks, rndA, rndB, k), S_Running(P, ks, rndA, rndB, k),
      Secret(P, ks, k) ]->
  [ Out(<'sfin', P, tagS>) ]

restriction Neq:
  "All x y #i. Neq(x, y) @i ==> not (x = y)"

restriction OnlyOnce:
  "All x #i #j. OnlyOnce(x) @i & OnlyOnce(x) @j ==> #i = #j"

/* === Lemmas === */

lemma executable:
  exists-trace
  "Ex P ks a b k #i #j.
     S_Accept(P, ks, a, b, k) @i & C_Accept(P, ks, a, b, k) @j &
     not (ks = 'zero') & not (Ex #r. Reveal(P, ks) @r)"

lemma session_key_secrecy:
  "All P ks k #i.
     Secret(P, ks, k) @i & not (ks = 'zero') &
     not (Ex #r. Reveal(P, ks) @r)
     ==> not (Ex #j. K(k) @j)"

/* Participant authenticates Configurator: injective agreement. */
lemma server_injective_agreement:
  "All P ks a b k #i.
     S_Accept(P, ks, a, b, k) @i & not (ks = 'zero') &
     not (Ex #r. Reveal(P, ks) @r)
     ==> (Ex #j. C_Running(P, ks, a, b, k) @j & j < i) &
         not (Ex P2 ks2 #i2. S_Accept(P2, ks2, a, b, k) @i2 & not (#i2 = #i))"

/* Configurator authenticates Participant: injective agreement. */
lemma client_injective_agreement:
  "All P ks a b k #i.
     C_Accept(P, ks, a, b, k) @i & not (ks = 'zero') &
     not (Ex #r. Reveal(P, ks) @r)
     ==> (Ex #j. S_Running(P, ks, a, b, k) @j & j < i) &
         not (Ex P2 ks2 #i2. C_Accept(P2, ks2, a, b, k) @i2 & not (#i2 = #i))"

/* Sanity: Zero-Key sessions are unauthenticated (expected: verified). */
lemma zero_key_unauthenticated:
  exists-trace
  "Ex P a b k #i.
     S_Accept(P, 'zero', a, b, k) @i &
     not (Ex #j. C_Running(P, 'zero', a, b, k) @j)"

end
