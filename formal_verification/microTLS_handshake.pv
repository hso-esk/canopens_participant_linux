(* ProVerif model: SPsec microTLS handshake. *)

free c: channel.

type key.

(* Key selectors. Seed Key is rejected for handshakes. *)
const zero, provisioning, integrator, seed: bitstring.
const n1, n2, cf, sf: bitstring.

(* The Zero Key is all-zero, i.e. public. *)
free zerokey: key.
fun psk(bitstring, bitstring): key [private].

fun hkdf(key, bitstring): key.
fun mac(key, bitstring): bitstring.
fun senc(bitstring, key): bitstring.
reduc forall m: bitstring, k: key; sdec(senc(m, k), k) = m.

letfun getpsk(p: bitstring, ks: bitstring) =
  if ks = zero then zerokey else psk(p, ks).

free secretC, secretS: bitstring [private].

event ClientRunning(bitstring, bitstring, bitstring, bitstring, key).
event ClientAccept(bitstring, bitstring, bitstring, bitstring, key).
event ServerRunning(bitstring, bitstring, bitstring, bitstring, key).
event ServerAccept(bitstring, bitstring, bitstring, bitstring, key).

(* Sanity: a full session completes (expected: "not event" is false). *)
query p, ks, a, b: bitstring, k: key; event(ClientAccept(p, ks, a, b, k)).
(* Sanity: Zero-Key sessions are reachable (expected: false). *)
query p, a, b: bitstring, k: key; event(ServerAccept(p, zero, a, b, k)).

(* Session key secrecy for non-Zero-Key sessions. *)
query attacker(secretC).
query attacker(secretS).

(* Injective agreement both ways, except for Zero-Key sessions. *)
query p, ks, a, b: bitstring, k: key;
  inj-event(ServerAccept(p, ks, a, b, k)) ==>
    inj-event(ClientRunning(p, ks, a, b, k)) || ks = zero.
query p, ks, a, b: bitstring, k: key;
  inj-event(ClientAccept(p, ks, a, b, k)) ==>
    inj-event(ServerRunning(p, ks, a, b, k)) || ks = zero.

let Client =
  in(c, (p: bitstring, ks: bitstring));
  if ks = zero || ks = provisioning || ks = integrator then
  new rA: bitstring;
  out(c, (p, ks, rA));
  in(c, rB: bitstring);
  let k = hkdf(getpsk(p, ks), (rA, rB)) in
  let tagC = mac(k, (n1, (cf, p, ks, rA, rB))) in
  event ClientRunning(p, ks, rA, rB, k);
  out(c, tagC);
  in(c, xtagS: bitstring);
  if xtagS = mac(k, (n2, (sf, p, rA, rB, tagC))) then
  event ClientAccept(p, ks, rA, rB, k);
  if ks <> zero then out(c, senc(secretC, k)).

let Server =
  in(c, (p: bitstring, ks: bitstring, rA: bitstring));
  if ks = zero || ks = provisioning || ks = integrator then
  new rB: bitstring;
  out(c, rB);
  in(c, xtagC: bitstring);
  let k = hkdf(getpsk(p, ks), (rA, rB)) in
  if xtagC = mac(k, (n1, (cf, p, ks, rA, rB))) then
  event ServerAccept(p, ks, rA, rB, k);
  event ServerRunning(p, ks, rA, rB, k);
  out(c, mac(k, (n2, (sf, p, rA, rB, xtagC))));
  if ks <> zero then out(c, senc(secretS, k)).

process
  !Client | !Server
