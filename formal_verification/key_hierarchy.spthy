theory key_hierarchy
begin

/* Tamarin model: SPsec key hierarchy. */

functions: hkdf/2, mac/2, aead/4, adec/4

equations: adec(aead(k, n, m, a), k, n, a) = m

restriction OnlyOnce:
  "All x #i #j. OnlyOnce(x) @i & OnlyOnce(x) @j ==> #i = #j"

/* Devices can be initialized as unprovisioned or provisioned at the factory. */
rule Device_Unprovisioned:
  [ ] --[ OnlyOnce(<'device', $P>) ]->
  [ !PSK($P, 'zero', 'zerokey'), !CKey($P, 'zero', 'zerokey'), DeviceUnprov($P) ]

rule Device_Provisioned:
  [ Fr(~key) ]
  --[ Gen($P, 'prov', ~key, 'oob'), Installed($P, 'prov', ~key),
      OnlyOnce(<'device', $P>), OnlyOnce(<'prov', $P>) ]->
  [ !PSK($P, 'zero', 'zerokey'), !CKey($P, 'zero', 'zerokey'),
    !CKey($P, 'prov', ~key), !PSK($P, 'prov', ~key), DeviceProv($P) ]
/* ---- Handshake (as in microtls.spthy) ---- */

rule C1_ClientHello:
  [ Fr(~rndA), !CKey($P, $ks, psk) ]
  -->
  [ St_C1($P, $ks, psk, ~rndA), Out(<'hello', $P, $ks, ~rndA>) ]

rule C2_ClientFinished:
  let k    = hkdf(psk, <rndA, rndB>)
      tagC = mac(k, <'1', <'cf', P, ks, rndA, rndB>>)
  in
  [ St_C1(P, ks, psk, rndA), In(<'shello', P, rndB>) ]
  -->
  [ St_C2(P, ks, psk, k, rndA, rndB, tagC), Out(<'cfin', P, tagC>) ]

rule C3_VerifyServerFinished:
  [ St_C2(P, ks, psk, k, rndA, rndB, tagC),
    In(<'sfin', P, mac(k, <'2', <'sf', P, rndA, rndB, tagC>>)>) ]
  -->
  [ !CSess(P, ks, psk, k) ]

rule S1_ServerHello:
  [ In(<'hello', $P, ks, rndA>), !PSK($P, ks, psk), Fr(~rndB) ]
  -->
  [ St_S1($P, ks, psk, rndA, ~rndB), Out(<'shello', $P, ~rndB>) ]

rule S2_VerifyClientFinished:
  let k    = hkdf(psk, <rndA, rndB>)
      tagC = mac(k, <'1', <'cf', P, ks, rndA, rndB>>)
      tagS = mac(k, <'2', <'sf', P, rndA, rndB, tagC>>)
  in
  [ St_S1(P, ks, psk, rndA, rndB), In(<'cfin', P, tagC>) ]
  -->
  [ !PSess(P, ks, k), Out(<'sfin', P, tagS>) ]

/* Provisioning Key cannot be written via protocol (register_check_access
   returns SPSEC_ERROR_REGISTER_ACCESS_DENIED for 21h). It is only loaded
   out-of-band at the factory as modeled by Device_Provisioned. */

/* ---- Configurator: generate and write a child key ---- */

/* Rule 1 & 5: When unprovisioned, Integrator Key can be written via Zero-Key session */
rule C_WriteIntegrator_Zero:
  [ !CSess(P, 'zero', psk, k), Fr(~key), Fr(~n) ]
  --[ Gen(P, 'integ', ~key, psk), InBandZeroOnboarding(P) ]->
  [ !CKey(P, 'integ', ~key),
    Out(<'write', P, ~n, aead(k, ~n, <'integ', ~key>, <'wr', P>)>) ]

/* Rule 4: When provisioned, Integrator Key is installed via Provisioning session */
rule C_WriteIntegrator_Prov:
  [ !CSess(P, 'prov', psk, k), Fr(~key), Fr(~n) ]
  --[ Gen(P, 'integ', ~key, psk) ]->
  [ !CKey(P, 'integ', ~key),
    Out(<'write', P, ~n, aead(k, ~n, <'integ', ~key>, <'wr', P>)>) ]
/* Rule 2: Seed Key requires Integrator Key session */
rule C_WriteSeed:
  [ !CSess(P, 'integ', psk, k), Fr(~key), Fr(~n) ]
  --[ Gen(P, 'seed', ~key, psk) ]->
  [ Out(<'write', P, ~n, aead(k, ~n, <'seed', ~key>, <'wr', P>)>) ]

/* ---- Participant: access policy of register_check_access ---- */

/* Rule 1 & 5: Unprovisioned node accepts Integrator Key via Zero-Key session (write-once) */
rule P_InstallIntegrator_Zero:
  [ DeviceUnprov(P), !PSess(P, 'zero', k),
    In(<'write', P, n, aead(k, n, <'integ', key>, <'wr', P>)>) ]
  --[ Installed(P, 'integ', key), OnlyOnce(<'integ', P>), AcceptOnce(<k, n>) ]->
  [ !PSK(P, 'integ', key) ]

/* Rule 4: Provisioned node accepts Integrator Key via Prov session */
rule P_InstallIntegrator_Prov:
  [ DeviceProv(P), !PSess(P, 'prov', k),
    In(<'write', P, n, aead(k, n, <'integ', key>, <'wr', P>)>) ]
  --[ Installed(P, 'integ', key), OnlyOnce(<'integ', P>), AcceptOnce(<k, n>) ]->
  [ !PSK(P, 'integ', key) ]

/* Rule 2: Seed Key can only be written via Integrator Key session */
rule P_InstallSeed:
  [ !PSess(P, 'integ', k),
    In(<'write', P, n, aead(k, n, <'seed', key>, <'wr', P>)>) ]
  --[ Installed(P, 'seed', key), OnlyOnce(<'seed', P>), AcceptOnce(<k, n>) ]->
  [ ]

restriction AcceptOnce:
  "All x #i #j. AcceptOnce(x) @i & AcceptOnce(x) @j ==> #i = #j"

/* === Lemmas === */

lemma executable:
  exists-trace
  "Ex P prov integ seed #i #j #l.
     Installed(P, 'prov', prov) @i & Installed(P, 'integ', integ) @j &
     Installed(P, 'seed', seed) @l &
     (Ex p1 #g1. Gen(P, 'seed', seed, p1) @g1) &
     not (Ex #x. K(prov) @x)"

/* Expected attack (trust on first use): anyone can install the
   Integrator Key of an unprovisioned device in a Zero-Key session. */
lemma attack_TOFU_integrator_key:
  exists-trace
  "Ex P key #i #j. Installed(P, 'integ', key) @i & K(key) @j &
     not (Ex psk #g. Gen(P, 'integ', key, psk) @g)"

/* Expected attack: passive eavesdropper learns Zero-Key protected Integrator Key. */
lemma attack_integrator_key_eavesdropped:
  exists-trace
  "Ex P key #i #j. Gen(P, 'integ', key, 'zerokey') @i & K(key) @j"

/* With the Provisioning Key delivered out of band (factory),
   Integrator and Seed Keys stay secret. */
lemma child_key_secrecy:
  "All P t key parent #i.
     Gen(P, t, key, parent) @i & not (t = 'prov') &
     not (Ex #z. InBandZeroOnboarding(P) @z)
     ==> not (Ex #j. K(key) @j)"

/* Same assumption: every Integrator/Seed Key installed at P was generated
   by an honest Configurator, before installation. */
lemma child_key_origin:
  "All P t key #i.
     Installed(P, t, key) @i & not (t = 'prov') &
     (Ex pk #o. Gen(P, 'prov', pk, 'oob') @o) &
     not (Ex #z. InBandZeroOnboarding(P) @z)
     ==> (Ex parent #j. Gen(P, t, key, parent) @j & #j < #i)"

/* Same assumption: each honest key write is installed at most once. */
lemma child_key_no_replay:
  "All P t key parent pk #i #j #g #o.
     Installed(P, t, key) @i & Installed(P, t, key) @j &
     Gen(P, t, key, parent) @g & Gen(P, 'prov', pk, 'oob') @o &
     not (t = 'prov') & not (Ex #z. InBandZeroOnboarding(P) @z)
     ==> #i = #j"

/* Expected attack: with in-band Zero-Key onboarding, an eavesdropper
   also learns the child keys (Seed Key included). */
lemma attack_seed_key_after_zero_key_onboarding:
  exists-trace
  "Ex P key parent #i #j. Gen(P, 'seed', key, parent) @i & K(key) @j &
     (Ex #z. InBandZeroOnboarding(P) @z)"
end
